{
    "name": "JARVIS — Personal Dashboard",
    "short_name": "JARVIS",
    "description": "Your personal dashboard for expenses, study time, and tasks.",
    "start_url": "./testing_cade_X.html",
    "scope": "./",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui"],
    "orientation": "any",
    "theme_color": "#236747",
    "background_color": "#f5f6f2",
    "icons": [
        {
            "src": "icons/jarvis-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "icons/jarvis-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "icons/jarvis.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Expenses",
            "url": "./expenses.html",
            "icons": [{ "src": "icons/jarvis.svg", "sizes": "any", "type": "image/svg+xml" }]
        },
        {
            "name": "Study time",
            "url": "./study.html",
            "icons": [{ "src": "icons/jarvis.svg", "sizes": "any", "type": "image/svg+xml" }]
        },
        {
            "name": "To-do list",
            "url": "./todos.html",
            "icons": [{ "src": "icons/jarvis.svg", "sizes": "any", "type": "image/svg+xml" }]
        }
    ]
}
